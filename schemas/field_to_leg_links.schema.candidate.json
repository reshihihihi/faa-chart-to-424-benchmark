{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/faa-chart-to-424/field_to_leg_links.schema.candidate.json",
  "title": "B1_prime_link field-to-leg links schema v0 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chart_id",
    "link_source",
    "source_contract",
    "leakage_policy",
    "source_field_candidates",
    "candidate_legs",
    "unlinked_candidates",
    "linking_warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "field_to_leg_links_schema_v0_candidate"
    },
    "chart_id": {
      "type": "string",
      "minLength": 1
    },
    "link_source": {
      "type": "string",
      "minLength": 1
    },
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "uses_flat_field_candidates",
        "allows_ocr_bbox",
        "allows_chart_image_pixels",
        "allows_roi_or_visual_cells"
      ],
      "properties": {
        "source": {
          "const": "same_chart_full_chart_ocr_text_and_flat_field_candidates"
        },
        "uses_flat_field_candidates": {
          "const": true
        },
        "allows_ocr_bbox": {
          "const": false
        },
        "allows_chart_image_pixels": {
          "const": false
        },
        "allows_roi_or_visual_cells": {
          "const": false
        }
      }
    },
    "leakage_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uses_canonical_target",
        "uses_expected_value",
        "uses_gold_field_to_leg_mapping",
        "uses_human_evidence_provenance",
        "uses_gold_observable_evidence",
        "uses_cifp_or_arinc_424",
        "uses_scorer_output"
      ],
      "properties": {
        "uses_canonical_target": {
          "const": false
        },
        "uses_expected_value": {
          "const": false
        },
        "uses_gold_field_to_leg_mapping": {
          "const": false
        },
        "uses_human_evidence_provenance": {
          "const": false
        },
        "uses_gold_observable_evidence": {
          "const": false
        },
        "uses_cifp_or_arinc_424": {
          "const": false
        },
        "uses_scorer_output": {
          "const": false
        }
      }
    },
    "source_field_candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "schema_version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_version": {
          "const": "field_candidates_schema_v1_candidate"
        }
      }
    },
    "candidate_legs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate_leg"
      }
    },
    "unlinked_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unlinked_candidate"
      }
    },
    "linking_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "candidate_leg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_leg_index",
        "link_type",
        "evidence",
        "source_span_start",
        "source_span_end",
        "confidence",
        "notes"
      ],
      "properties": {
        "candidate_leg_index": {
          "type": "integer",
          "minimum": 0
        },
        "link_type": {
          "enum": [
            "direct_to_fix",
            "track_to_fix",
            "course_to_fix",
            "radial_to_fix",
            "hold_at_fix",
            "unknown_link"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_item"
          }
        },
        "source_span_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source_span_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "target_leg_index"
            ]
          },
          {
            "required": [
              "expected_value"
            ]
          },
          {
            "required": [
              "target_value"
            ]
          },
          {
            "required": [
              "score"
            ]
          }
        ]
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_type",
        "value",
        "relation_to_leg",
        "source_candidate_group",
        "source_candidate_index",
        "source_snippet",
        "source_section",
        "source_start_char",
        "source_end_char",
        "rule_id",
        "confidence",
        "notes"
      ],
      "properties": {
        "field_type": {
          "enum": [
            "fix_ident",
            "altitude_ft",
            "turn_direction",
            "course_deg",
            "radial_deg",
            "heading_deg",
            "hold_phrase",
            "direct_phrase",
            "climb_phrase",
            "track_to_fix_phrase",
            "route_sequence_snippet",
            "missed_approach_instruction",
            "other_ocr_candidate"
          ]
        },
        "value": {
          "type": [
            "string",
            "integer",
            "number",
            "boolean",
            "null"
          ]
        },
        "relation_to_leg": {
          "enum": [
            "fix",
            "altitude",
            "turn",
            "course_or_radial",
            "hold",
            "phrase",
            "context"
          ]
        },
        "source_candidate_group": {
          "type": "string",
          "minLength": 1
        },
        "source_candidate_index": {
          "type": "integer",
          "minimum": 0
        },
        "source_snippet": {
          "type": "string"
        },
        "source_section": {
          "type": "string"
        },
        "source_start_char": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source_end_char": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "unlinked_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_candidate_group",
        "source_candidate_index",
        "field_type",
        "value",
        "reason",
        "source_snippet"
      ],
      "properties": {
        "source_candidate_group": {
          "type": "string",
          "minLength": 1
        },
        "source_candidate_index": {
          "type": "integer",
          "minimum": 0
        },
        "field_type": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "integer",
            "number",
            "boolean",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_snippet": {
          "type": "string"
        }
      }
    }
  }
}
