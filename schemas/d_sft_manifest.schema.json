{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D-SFT Manifest Row",
  "type": "object",
  "required": [
    "sample_id",
    "split",
    "chart_id",
    "airport",
    "proc_ident",
    "chart_name",
    "procedure_type",
    "pdf_name",
    "pdf_path",
    "image_path",
    "target_path",
    "family_key",
    "image_sha256",
    "target_sha256",
    "label_source",
    "excluded_from_formal_evaluation"
  ],
  "properties": {
    "sample_id": {"type": "string"},
    "split": {"type": "string", "enum": ["train", "dev"]},
    "chart_id": {"type": "string"},
    "airport": {"type": "string"},
    "proc_ident": {"type": "string"},
    "chart_name": {"type": "string"},
    "procedure_type": {"type": "string"},
    "pdf_name": {"type": "string"},
    "pdf_path": {"type": "string"},
    "image_path": {"type": "string"},
    "target_path": {"type": "string"},
    "raw_cifp_file": {"type": "string"},
    "family_key": {"type": "string"},
    "leg_count": {"type": "integer", "minimum": 0},
    "image_sha256": {"type": "string"},
    "target_sha256": {"type": "string"},
    "pdf_sha256": {"type": "string"},
    "label_source": {"type": "string"},
    "excluded_from_formal_evaluation": {"type": "boolean"}
  },
  "additionalProperties": true
}
