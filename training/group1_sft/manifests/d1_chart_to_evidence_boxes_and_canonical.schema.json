{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reshihihihi/faa-chart-to-424-benchmark/training/group1_sft/manifests/d1_chart_to_evidence_boxes_and_canonical.schema.json",
  "title": "D1 Chart Evidence Boxes Plus Canonical Output",
  "type": "object",
  "required": ["evidence_boxes", "canonical_prediction"],
  "additionalProperties": false,
  "properties": {
    "evidence_boxes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/evidence_box" }
    },
    "canonical_prediction": {
      "type": "object"
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "minimum": 0, "maximum": 1 }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "evidence_box": {
      "type": "object",
      "required": ["box_id", "bbox", "region_type"],
      "additionalProperties": false,
      "properties": {
        "box_id": {
          "type": "string",
          "enum": ["missed_approach_text", "plan_view_context", "missed_approach_detail_area"]
        },
        "bbox": { "$ref": "#/$defs/bbox" },
        "region_type": {
          "type": "string",
          "enum": [
            "MISSED_APPROACH_TEXT",
            "PLAN_VIEW",
            "MISSED_APPROACH_DETAIL_AREA"
          ]
        }
      }
    }
  }
}
