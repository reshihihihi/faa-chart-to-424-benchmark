{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment6/verification_case_schema.json",
  "title": "Experiment 6 Verification Counterfactual Case",
  "type": "object",
  "required": [
    "verification_case_id",
    "chart_id",
    "sample_id",
    "split",
    "image_path",
    "image_sha256",
    "candidate_record",
    "label",
    "construction"
  ],
  "additionalProperties": false,
  "properties": {
    "verification_case_id": { "type": "string" },
    "chart_id": { "type": "string" },
    "sample_id": { "type": "string" },
    "split": { "type": "string", "enum": ["development", "probe", "evaluation"] },
    "image_path": { "type": "string" },
    "image_sha256": { "type": "string" },
    "candidate_record": { "$ref": "candidate_424_like_schema.json" },
    "label": {
      "type": "object",
      "required": ["consistent", "error_fields", "counterfactual_type"],
      "additionalProperties": false,
      "properties": {
        "consistent": { "type": "boolean" },
        "error_fields": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "counterfactual_type": { "type": "string" }
      }
    },
    "construction": {
      "type": "object",
      "required": ["source_target_sha256", "builder_version", "mutation_rule", "mutation_notes"],
      "additionalProperties": false,
      "properties": {
        "source_target_sha256": { "type": "string" },
        "builder_version": { "type": "string" },
        "mutation_rule": { "type": "string" },
        "mutation_notes": { "type": "string" }
      }
    }
  }
}
